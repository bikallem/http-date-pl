{
  "name": "http-date-pl SWI-Prolog (Debian 13)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "containerUser": "root",
  "runArgs": [],
  "customizations": {
    "vscode": {
      "extensions": [
        "arthurwang.vscode-prolog",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "postCreateCommand": "swipl --version",
  "mounts": []
}
